# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Dev server only (`npm run dev`): the local game server (../Build-the-skyscraper-backend, `npm start`).
# Built games ignore it and reach their server through the Bloxity matchmaker.
VITE_SERVER_URL_DEV=ws://localhost:2567
